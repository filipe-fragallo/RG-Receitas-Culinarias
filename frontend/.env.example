# =============================================================================
# Frontend — copie para .env (cp .env.example .env)
# O Vite lê estas variáveis no build e no vite.config.ts (proxy de dev).
# =============================================================================

# Caminho usado pelo navegador. Mantenha /api para usar o proxy do Vite em
# desenvolvimento e o proxy do Nginx no container. A sessão vive em cookies
# HttpOnly com Path=/api e sem Domain; usar uma URL absoluta de outro host
# impediria o navegador de enviá-los. No Vercel, mantenha /api: o rewrite em
# vercel.json encaminha /api/* para a URL pública do backend.
VITE_API_URL=/api

# Destino do proxy /api no servidor de desenvolvimento.
# Padrão: http://localhost:3000 (backend local).
# Se o backend estiver em outra porta, ajuste aqui.
# Ex.: VITE_PROXY_TARGET=http://localhost:3000
VITE_PROXY_TARGET=http://localhost:3000

# Portas do Vite. Os padrões são 5173 (dev) e 4173 (preview).
# VITE_PORT=5173
# VITE_PREVIEW_PORT=4173

# --- E2E com Playwright -------------------------------------------------------
# O E2E local usa MySQL loopback descartável, nunca o de desenvolvimento.
# E2E_DB_HOST=127.0.0.1
# E2E_DB_PORT=3310
# E2E_DB_USER=root
# E2E_DB_PASSWORD=root
# E2E_DB_NAME=teste_receitas_rg_sistemas_playwright
# E2E_BACKEND_URL=http://localhost:3010
# E2E_FRONTEND_URL=http://localhost:5173
