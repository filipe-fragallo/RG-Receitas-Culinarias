{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://__BACKEND_VERCEL_HOST__/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://__BACKEND_VERCEL_HOST__/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
