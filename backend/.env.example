# =============================================================================
# Backend — copie para .env e ajuste os valores
# =============================================================================
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=receitas
DB_PASSWORD=receitas_dev
DB_NAME=teste_receitas_rg_sistemas

# Use uma string aleatória com pelo menos 32 caracteres.
# Exemplo: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-uma-string-aleatoria-com-32-caracteres-ou-mais
JWT_EXPIRES_IN_SECONDS=3600

# Origens permitidas separadas por vírgula
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
