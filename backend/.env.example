# =============================================================================
# Backend — copie para .env (cp .env.example .env)
# Este mesmo arquivo é lido pelo NestJS e pelo Docker Compose em backend/.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# Porta em que o NestJS escuta quando executado localmente.
# O backend publicado pelo Docker usa BACKEND_HOST_PORT (padrão 3001); a porta
# interna do container permanece 3000. Se 3000 estiver ocupada, a API aborta
# antes de abrir conexões ou aplicar migrations, sem encerrar processos. Defina
# PORT aqui e ajuste VITE_PROXY_TARGET no frontend/.env.
NODE_ENV=development
PORT=3000

# --- MySQL -------------------------------------------------------------------
# DB_HOST/DB_PORT são usados pelo backend rodando localmente.
# O MySQL sobe via Docker Compose e publica MYSQL_HOST_PORT no host.
# Mantenha DB_PORT igual a MYSQL_HOST_PORT.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teste_receitas_rg_sistemas

# Credenciais compartilhadas entre o container MySQL e o backend.
DB_USER=receitas
DB_PASSWORD=receitas_dev
MYSQL_ROOT_PASSWORD=root

# --- Docker Compose ----------------------------------------------------------
# Portas publicadas no computador (host). As portas internas continuam:
#   API NestJS: 3000 | Frontend/Nginx: 80 | MySQL: 3306
# MySQL e API são vinculados a 127.0.0.1 pelo Compose; a porta direta da API
# serve apenas para depuração local e não deve ser exposta à rede.
# BACKEND_HOST_PORT usa 3001 para não disputar a porta local do NestJS.
# Altere somente se a porta do host estiver ocupada por outro programa.
MYSQL_HOST_PORT=3306
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=8080

# --- Segurança ---------------------------------------------------------------
# JWT_SECRET é obrigatório (mínimo de 32 caracteres), inclusive no Docker com
# --profile full. Não use um valor de exemplo: gere um segredo único e adicione
# ao seu .env, que não deve ser versionado:
#   echo "JWT_SECRET=$(openssl rand -hex 32)" >> .env
JWT_EXPIRES_IN_SECONDS=3600

# O JWT fica somente no cookie HttpOnly `rg_auth` (Path=/api, sem Domain).
# Em produção COOKIE_SECURE é obrigatório e exige HTTPS. Fora dela, false só é
# aceito quando TODAS as origens CORS são loopback (Vite/Nginx local).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Confie apenas no proxy imediato (Nginx do Compose) para calcular o IP real.
# DESLIGADO no desenvolvimento: X-Forwarded-For enviado pelo cliente é ignorado.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Limites de login/cadastro por IP e por login normalizado. ttl em milissegundos.
LOGIN_RATE_LIMIT_LIMIT=5
LOGIN_RATE_LIMIT_TTL_MS=60000
REGISTER_RATE_LIMIT_LIMIT=3
REGISTER_RATE_LIMIT_TTL_MS=3600000

# Origens permitidas separadas por vírgula (Vite local e frontend Docker).
# Nunca use `*` com cookies. O Compose usa este valor quando presente; caso
# contrário monta o padrão com FRONTEND_HOST_PORT.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Log SQL (opcional, útil para depurar). Padrão: false.
# DB_LOGGING=true

# --- Proteção de banco -------------------------------------------------------
# Por padrão, o bootstrap aplica migrations somente em desenvolvimento local.
# Em produção ou host remoto, execute `npm run db:migrate` explicitamente.
# DB_ALLOW_PRODUCTION_MIGRATIONS=true autoriza db:migrate/db:seed em produção.
# DB_ALLOW_REMOTE=true exige DB_ALLOWED_HOST=<host> com o nome exato do host
# remoto; sem isso nenhuma escrita remota é autorizada.
# Comandos destrutivos (db:down/db:reset) nunca são permitidos em produção ou
# em host remoto e exigem o argumento --yes.
# DB_MIGRATIONS_AUTO=false
# DB_ALLOW_REMOTE=false
# DB_ALLOWED_HOST=
# DB_ALLOW_PRODUCTION_MIGRATIONS=false

# --- Testes ------------------------------------------------------------------
# Suítes usam schemas _test e _e2e em 127.0.0.1. Para um MySQL remoto
# autorizado, defina TEST_DB_ALLOW_REMOTE=true e TEST_DB_ALLOWED_HOST=<host>.
# TEST_DB_ALLOW_REMOTE=false
# TEST_DB_ALLOWED_HOST=

# --- E2E do navegador (backend/docker-compose.e2e.yml) -------------------
# Portas de host do overlay descartável; os defaults não disputam 3000/3306/8080.
# E2E_MYSQL_HOST_PORT=3311
# E2E_BACKEND_HOST_PORT=3011
# E2E_FRONTEND_HOST_PORT=8091
