# =============================================================================
# Variáveis usadas pelo Docker Compose (copie para .env na raiz do projeto)
# =============================================================================

# MySQL
# O nome do banco é fixo (teste_receitas_rg_sistemas), conforme o desafio.
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=receitas
MYSQL_PASSWORD=receitas_dev
MYSQL_PORT=3306

# Backend
BACKEND_PORT=3000
JWT_SECRET=troque-este-segredo-por-uma-string-aleatoria-com-32-caracteres-ou-mais
JWT_EXPIRES_IN_SECONDS=3600
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Frontend
FRONTEND_PORT=8080
